                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const orders = pm.response.json();",
                  "pm.test(\"Se crean 2 pedidos (uno por productor)\", () => pm.expect(orders).to.have.lengthOf(2));",
                  "pm.test(\"Todos en estado PENDING\", () => orders.forEach(o => pm.expect(o.status).to.eql(\"PENDING\")));",
                  "const mine = orders.find(o => o.producer.id === pm.environment.get(\"producer1Id\"));",
                  "pm.test(\"Total del pedido = 4 x 20.000\", () => pm.expect(mine.total).to.eql(80000));",
                  "pm.environment.set(\"orderId\", mine.id);"
                ]
              }
