      "name": "01 Autenticación",
      "item": [
        {
          "name": "API-01 Login correcto (comprador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Devuelve token JWT\", () => pm.expect(b.accessToken).to.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/));",
                  "pm.test(\"No expone el hash de la contraseña\", () => pm.expect(b.user).to.not.have.property(\"passwordHash\"));",
                  "pm.test(\"Rol comprador\", () => pm.expect(b.user.role).to.eql(\"BUYER\"));",
                  "pm.environment.set(\"buyerToken\", b.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "SWR-AUTH-001",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"comprador1@agrohuila.co\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
