    {
      "name": "02 Catálogo",
      "item": [
        {
          "name": "API-04 Búsqueda combinada: municipio + precio mínimo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Hay resultados\", () => pm.expect(b.items.length).to.be.above(0));",
                  "pm.test(\"Todos son de Garzón y cuestan >= 5000\", () => b.items.forEach(p => {",
                  "  pm.expect(p.producer.municipality).to.eql(\"Garzón\");",
                  "  pm.expect(p.price).to.be.at.least(5000);",
                  "}));",
                  "pm.test(\"Página de máximo 20\", () => pm.expect(b.pageSize).to.eql(20));",
                  "pm.environment.set(\"producer2ProductId\", b.items.find(p => p.quantity > 0).id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?municipality=Garzón&minPrice=5000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "municipality",
                  "value": "Garzón"
                },
                {
                  "key": "minPrice",
                  "value": "5000"
                }
              ]
            },
            "description": "SWR-SRCH-006 (regla de dominio)"
